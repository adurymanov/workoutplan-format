{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adurymanov/workoutplan-format/main/schema/workoutplan-v1.schema.json",
  "title": "workoutplan v1",
  "description": "An open interchange format for structured workouts that can be scheduled onto an Apple Watch. This schema describes the canonical writer profile: readers additionally accept the documented aliases (see SPEC.md).",
  "type": "object",
  "required": ["workouts"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "workouts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workout" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "patternProperties": { "^x-": true },
  "additionalProperties": false,

  "$defs": {
    "extensions": {
      "type": "object",
      "description": "Reserved for vendor data. Conforming readers ignore the contents but preserve them when rewriting the file."
    },

    "scheduledDate": {
      "type": "string",
      "description": "Local wall-clock time (\"2026-09-08T07:30:00\") or an absolute ISO-8601 timestamp with an offset (\"2026-09-08T04:30:00Z\").",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?)?(([Zz])|([+-][0-9]{2}:?[0-9]{2}))?$"
    },

    "activity": {
      "type": "string",
      "enum": [
        "running", "cycling", "walking", "swimming", "hiking", "rowing", "elliptical",
        "functionalStrengthTraining", "traditionalStrengthTraining",
        "highIntensityIntervalTraining", "coreTraining",
        "flexibility", "yoga", "pilates", "jumpRope", "stairClimbing", "kickboxing",
        "mixedCardio", "cardioDance", "cooldown", "handCycling",
        "downhillSkiing", "crossCountrySkiing", "paddleSports",
        "wheelchairWalkPace", "wheelchairRunPace"
      ]
    },
    "location": { "enum": ["unknown", "indoor", "outdoor"] },
    "swimmingLocation": { "enum": ["unknown", "pool", "openWater"] },
    "purpose": { "enum": ["work", "recovery"] },
    "metric": { "enum": ["current", "average"] },

    "lengthUnit": { "enum": ["m", "km", "mi", "yd", "ft"] },
    "timeUnit": { "enum": ["s", "min", "h"] },
    "energyUnit": { "enum": ["kcal", "kJ", "J"] },
    "powerUnit": { "enum": ["W", "kW"] },
    "speedUnit": { "enum": ["kmh", "mph", "mps"] },
    "countUnit": {
      "enum": ["bpm", "rpm", "spm"],
      "description": "Accepted but ignored: heart rate and cadence are always counts per minute."
    },

    "distanceMeasure": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "$ref": "#/$defs/lengthUnit" }
      },
      "additionalProperties": false
    },
    "timeMeasure": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "$ref": "#/$defs/timeUnit" }
      },
      "additionalProperties": false
    },
    "openGoal": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "open" } },
      "additionalProperties": false
    },
    "distanceGoal": {
      "type": "object",
      "required": ["type", "value", "unit"],
      "properties": {
        "type": { "const": "distance" },
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "$ref": "#/$defs/lengthUnit" }
      },
      "additionalProperties": false
    },
    "timeGoal": {
      "type": "object",
      "required": ["type", "value", "unit"],
      "properties": {
        "type": { "const": "time" },
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "$ref": "#/$defs/timeUnit" }
      },
      "additionalProperties": false
    },
    "energyGoal": {
      "type": "object",
      "required": ["type", "value", "unit"],
      "properties": {
        "type": { "const": "energy" },
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "$ref": "#/$defs/energyUnit" }
      },
      "additionalProperties": false
    },
    "poolSwimGoal": {
      "type": "object",
      "required": ["type", "distance", "time"],
      "properties": {
        "type": { "const": "poolSwimDistanceWithTime" },
        "distance": { "$ref": "#/$defs/distanceMeasure" },
        "time": { "$ref": "#/$defs/timeMeasure" }
      },
      "additionalProperties": false
    },

    "goal": {
      "description": "Any goal. Only a single-goal workout may use every variant.",
      "oneOf": [
        { "$ref": "#/$defs/openGoal" },
        { "$ref": "#/$defs/distanceGoal" },
        { "$ref": "#/$defs/timeGoal" },
        { "$ref": "#/$defs/energyGoal" },
        { "$ref": "#/$defs/poolSwimGoal" }
      ]
    },
    "stepGoal": {
      "description": "A goal usable inside a custom workout. Energy goals are excluded: WorkoutKit does not support them there.",
      "oneOf": [
        { "$ref": "#/$defs/openGoal" },
        { "$ref": "#/$defs/distanceGoal" },
        { "$ref": "#/$defs/timeGoal" },
        { "$ref": "#/$defs/poolSwimGoal" }
      ]
    },

    "alert": {
      "description": "At most one alert per step - a WorkoutKit limitation.",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "zone"],
          "properties": {
            "type": { "const": "heartRateZone" },
            "zone": { "type": "integer", "minimum": 1, "maximum": 5 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "min", "max"],
          "properties": {
            "type": { "const": "heartRateRange" },
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "max": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "$ref": "#/$defs/countUnit" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "min", "max"],
          "properties": {
            "type": { "const": "cadenceRange" },
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "max": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "$ref": "#/$defs/countUnit" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "cadenceThreshold" },
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "$ref": "#/$defs/countUnit" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "zone"],
          "properties": {
            "type": { "const": "powerZone" },
            "zone": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "min", "max"],
          "properties": {
            "type": { "const": "powerRange" },
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "max": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "$ref": "#/$defs/powerUnit" },
            "metric": { "$ref": "#/$defs/metric" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "powerThreshold" },
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "$ref": "#/$defs/powerUnit" },
            "metric": { "$ref": "#/$defs/metric" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "min", "max"],
          "properties": {
            "type": { "const": "speedRange" },
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "max": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "$ref": "#/$defs/speedUnit" },
            "metric": { "$ref": "#/$defs/metric" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "speedThreshold" },
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "$ref": "#/$defs/speedUnit" },
            "metric": { "$ref": "#/$defs/metric" }
          },
          "additionalProperties": false
        }
      ]
    },

    "step": {
      "type": "object",
      "properties": {
        "purpose": { "$ref": "#/$defs/purpose" },
        "goal": { "$ref": "#/$defs/stepGoal" },
        "alert": { "$ref": "#/$defs/alert" },
        "displayName": { "type": "string" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "block": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "iterations": { "type": "integer", "minimum": 1 },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "leg": {
      "type": "object",
      "required": ["sport"],
      "properties": {
        "sport": { "enum": ["swimming", "cycling", "running"] },
        "location": { "$ref": "#/$defs/location" },
        "swimmingLocation": { "$ref": "#/$defs/swimmingLocation" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "workout": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["custom", "goal", "pacer", "swimBikeRun"] },
        "scheduledDate": { "$ref": "#/$defs/scheduledDate" },
        "displayName": { "type": "string" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "custom" } }, "required": ["type"] },
          "then": {
            "required": ["activity"],
            "properties": {
              "activity": { "$ref": "#/$defs/activity" },
              "location": { "$ref": "#/$defs/location" },
              "warmup": { "$ref": "#/$defs/step" },
              "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
              "cooldown": { "$ref": "#/$defs/step" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "goal" } }, "required": ["type"] },
          "then": {
            "required": ["activity", "goal"],
            "properties": {
              "activity": { "$ref": "#/$defs/activity" },
              "location": { "$ref": "#/$defs/location" },
              "swimmingLocation": { "$ref": "#/$defs/swimmingLocation" },
              "goal": { "$ref": "#/$defs/goal" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pacer" } }, "required": ["type"] },
          "then": {
            "required": ["activity", "distance", "time"],
            "properties": {
              "activity": { "$ref": "#/$defs/activity" },
              "location": { "$ref": "#/$defs/location" },
              "distance": { "$ref": "#/$defs/distanceMeasure" },
              "time": { "$ref": "#/$defs/timeMeasure" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "swimBikeRun" } }, "required": ["type"] },
          "then": {
            "required": ["legs"],
            "properties": {
              "legs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/leg" } }
            }
          }
        }
      ],
      "patternProperties": { "^x-": true },
      "unevaluatedProperties": false
    }
  }
}
